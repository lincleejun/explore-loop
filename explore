        if not wt.is_dir(): msg = f"worktree {wt} 不在了：重建它，或 explore close {eid} --as 放弃 --why …"
        elif ahead in ("", "0"): msg = f"还没有提交。在 {wt} 里实现并提交"
        elif row and row["status"] == "拦下": msg = f"上次被拦在「{row['step']}」：{'；'.join(row['why'])[:160]}。修好后 explore land {eid}，或 explore close {eid} --as …"
        elif R.strict and not (R.dir / "experiments" / f"{eid}.review.md").exists(): msg = f"explore land {eid} --dry-run，然后请评审写 experiments/{eid}.review.md"
        else: msg = f"explore land {eid}"
        print(f"{eid}：{msg}")
    if not todo: print('没有进行中的实验。开一个：explore new "标题" --target <指标> --allow <文件通配>')
    dirty = git(R.dir, "status", "--porcelain", ok=True)
    if dirty: print(f"战役目录有 {len(dirty.splitlines())} 个没提交的文件：git -C {R.dir} add -A && git -C {R.dir} commit -m …")


