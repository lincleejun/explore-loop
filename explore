#!/usr/bin/env python3
"""explore: a tool for measured improvement experiments. It owns three things: is the measurement right, may this land, is it on the ledger.

Daily:
  explore init DIR --repo REPO --measure CMD --test CMD [--build CMD] [--rounds 10] [--width 3]   create the campaign directory and the baseline worktree
  explore aa                        calibrate: measure the same code on both sides to get each metric's noise. Redo after changing machine or measure command
  (one round per new baseline, loop.rounds rounds in all: write the profile to rounds/<base>/profiling.md; loop.width investigators take one topic each
   and each hands in rounds/<base>/<agent>-<topic>.md)
  explore new "idea" --target METRIC --by PROPOSAL [--allow 'src/x/*'] [--predict N]   open an experiment: id, worktree, one-page record
  (a different agent reviews the contract and writes experiments/E###.proposal.review.md)
  explore land E### [--dry-run]     the gate: proposal review -> scope -> tests -> invariants -> (strict: code review) -> measure -> verdict -> fast-forward -> ledger
  explore close E### --as abandoned|rejected|redirected --why REASON
  explore next                      where things are stuck and what the next command is
  explore status                    the ledger (prediction next to result for every experiment)

Other:
  explore power [--noise 3] [--metrics 15] [--pairs 10]   how often this rule blocks on pure noise and how big a change it can see, at your noise
  explore ab BASE_WT CAND_WT        compare two worktrees only, land nothing
  explore doctor [--snapshot]       check the config; --snapshot re-records the fingerprints of locked paths
  explore holdout NAME --why REASON -- CMD   use a holdout set once and log it
  explore guide                     the full instructions for agents (the body of SKILL.md). Any agent runs this first
  explore selftest

Exit codes: 0 = done; 1 = blocked or regression (the reason is in the output and on the ledger); 2 = this measurement is void (machine busy), retry later.

Campaign directory: --run DIR, or the EXPLORE_RUN environment variable, or the current directory.
Metric lines (printed by the measure command):  PERF <name> <number> <s|ms>            a duration, lower is better
                                                METRIC <lower|higher|exact> <name> <value> <unit>   exact = must be identical
Verdict: baseline and candidate are measured in n pairs; a metric counts as changed only if both hold (as in criterion.rs and asv):
  the direction is significant: the exact binomial tail of the number of pairs where the candidate is better (or worse) is <= alpha / number of metrics;
  the size is large enough: the median of the paired differences is beyond a threshold.
  For targets the threshold is the contract's min_gain (default 0) -> better. For every other metric it is the tolerance
  max(guard% x baseline median, floor, calibrated noise) -> regression.
  No verdict = inconclusive, which is not "no regression".
"""
import argparse, contextlib, datetime, fcntl, fnmatch, hashlib, json, math, os, pathlib, platform, random, re, shutil, statistics, subprocess, sys, tomllib

P = pathlib.Path
HERE = P(__file__).resolve().parent
LINE = re.compile(r"(?:PERF|BENCH) (.+?) (-?\d+(?:\.\d+)?(?:[eE]-?\d+)?) (s|ms)\s*$|METRIC (lower|higher|exact) (.+?) (\S+) (\S+)\s*$")
NEED = {"contract": ["id", "title", "targets"], "review": ["target", "sha", "findings"], "proposal-review": ["target", "by", "contract", "findings"]}   # the fields the machine uses; anything else is free
DONE = ("accepted", "abandoned", "rejected", "redirected")
OLD = {"接受": "accepted", "放弃": "abandoned", "拒绝": "rejected", "改向": "redirected", "拦下": "blocked", "改合同": "amended", "快照": "snapshot"}   # statuses in ledgers written before the tool spoke English


def die(msg, code=1):
    print(f"explore: {msg}", file=sys.stderr); sys.exit(code)


def sh(cmd, cwd, log=None, env=None):
    p = subprocess.run(cmd, shell=True, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env={**os.environ, **(env or {})})
    if log:
        log.parent.mkdir(parents=True, exist_ok=True); log.write_text(p.stdout)
    return p.returncode, p.stdout


def git(wt, *a, ok=False):
    p = subprocess.run(["git", "-C", str(wt), *a], capture_output=True, text=True)
    if p.returncode and not ok: die(f"git {' '.join(a)} ({wt}): {p.stderr.strip()}")
    return p.stdout.strip()


def slug(name): return re.sub(r"[^\w.-]", "-", name)   # agent name -> file name


def now(): return datetime.datetime.now().isoformat(timespec="seconds")


# ---------- metrics and verdicts ----------

def parse(text, where=""):
    """One pass of output -> {name: {v, raw, unit, way}}. The same name twice = the measure command is broken; do not guess."""
    out = {}
    for m in map(LINE.search, text.splitlines()):
        if not m: continue
        name = m[1] or m[5]
        if name in out: die(f"{where}: metric {name} appears twice in one pass")
        if m[1]: out[name] = {"v": float(m[2]) / (1000 if m[3] == "ms" else 1), "raw": m[2] + m[3], "unit": "s", "way": "lower"}
        else:
            try: v = float(m[6])
            except ValueError: v = None
            if m[4] != "exact" and (v is None or not math.isfinite(v)): die(f"{where}: the value {m[6]} of metric {name} is not a finite number")
            out[name] = {"v": v, "raw": m[6], "unit": m[7], "way": m[4]}
    return out


def tail(k, n):
    """Exact probability of at least k out of n pairs (each pair a coin flip)."""
    return sum(math.comb(n, j) for j in range(k, n + 1)) / 2 ** n


def decide(b, c, way, gain, loss, cut):
    """b[i] and c[i] are baseline and candidate from the same pair. Both conditions must hold: the direction is significant
    (sign test) and the median difference is beyond the threshold. Returns (verdict, pairs where the candidate is better, pairs where it is worse)."""
    s = 1 if way == "higher" else -1
    d = [s * (y - x) for x, y in zip(b, c)]; med = statistics.median(d)
    up, down = sum(x > 0 for x in d), sum(x < 0 for x in d); n = up + down   # tied pairs carry no direction and are left out of n
    if tail(up, n) <= cut: return ("better" if med > gain else "inconclusive"), up, down
    if tail(down, n) <= cut: return ("regression" if med < -loss else "worse"), up, down     # worse = really worse, but within tolerance
    return ("suspect" if med < -loss else "inconclusive"), up, down                          # suspect = the median is over the line, the direction is not significant


def need_pairs(m, alpha): return math.ceil(math.log2(m / alpha))   # with fewer pairs, even all pairs agreeing is not significant


def load(out):
    """Measurement directory -> {name: {unit, way, b: [..], c: [..], raw: set}}. Every pass must have the same metrics, units and directions."""
    out = P(out); data = {}; n = len(list((out / "base").glob("run-*.log")))
    if not n or n != len(list((out / "cand").glob("run-*.log"))): die(f"{out}: the two sides have different numbers of passes, or none")
    for i in range(1, n + 1):
        for side in ("base", "cand"):
            f = out / side / f"run-{i}.log"; got = parse(f.read_text(), str(f))
            if i == 1 and side == "base": data = {k: {"unit": v["unit"], "way": v["way"], "b": [], "c": [], "raw": set()} for k, v in got.items()}
            if {k: (v["unit"], v["way"]) for k, v in got.items()} != {k: (v["unit"], v["way"]) for k, v in data.items()}:
                die(f"{f}: the set of metrics, a unit or a direction differs from the first pass (a missing metric = something was skipped silently): {sorted(set(got) ^ set(data)) or 'unit / direction changed'}")
            for k, v in got.items(): data[k]["b" if side == "base" else "c"].append(v["v"]); data[k]["raw"].add(v["raw"])
    if not data: die(f"{out}: no metric lines at all")
    return data


def judge(data, rule, targets=(), gains=None, noise=None, out=None):
    m = len(data); n = len(next(iter(data.values()))["b"]); cut = rule["alpha"] / m; rows = []
    if n < need_pairs(m, rule["alpha"]): die(f"{m} metrics at alpha {rule['alpha']} need at least {need_pairs(m, rule['alpha'])} pairs before any change can be judged; there are only {n}")
    for k, x in sorted(data.items()):
        if x["way"] == "exact":
            rows.append({"metric": k, "verdict": "same" if len(x["raw"]) == 1 else "differs", "values": sorted(x["raw"])[:4]}); continue
        mb, mc = statistics.median(x["b"]), statistics.median(x["c"])
        loss = max(rule["guard"] / 100 * abs(mb), rule["floor"], (noise or {}).get(k, 0))
        v, up, down = decide(x["b"], x["c"], x["way"], (gains or {}).get(k, 0) if k in targets else 0, loss, cut)
        rows.append({"metric": k, "unit": x["unit"], "verdict": v, "base": mb, "cand": mc, "change": round((mc - mb) / abs(mb) * 100, 2) if mb else None,
                     "up": up, "down": down, "n": n, "loss": loss, "target": k in targets})
    def line(r):
        if "base" not in r: return f"| {r['metric']} | {' / '.join(r['values'])} | | | | {r['verdict']} |"
        ch = f"{r['change']:+.1f}%" if r["change"] is not None else "—"
        return f"| {'**' + r['metric'] + '**' if r['target'] else r['metric']} | {r['base']:.4g} {r['unit']} | {r['cand']:.4g} {r['unit']} | {ch} | better {r['up']} / worse {r['down']} / of {r['n']} | {r['verdict']} |"
    head = ["| metric (**target**) | baseline median | candidate median | change | paired comparison | verdict |", "|---|---|---|---|---|---|"]
    show = [r for r in rows if r.get("target") or r["verdict"] not in ("inconclusive", "same")]   # show only targets and metrics that moved
    print("\n".join(head + [line(r) for r in show])); print(f"The other {len(rows) - len(show)} metrics show no change that can be judged (significance line: one-sided p <= {cut:.4f})")
    if out:
        (P(out) / "verdict.json").write_text(json.dumps(rows, ensure_ascii=False, indent=1))
        (P(out) / "verdict.md").write_text("\n".join(head + [line(r) for r in rows]) + "\n")
    return rows


def blockers(rows, targets):
    by = {r["metric"]: r for r in rows}
    return [f"target {t}: {by.get(t, {}).get('verdict', 'not measured')}" for t in targets if by.get(t, {}).get("verdict") != "better"] + \
           [f"{r['metric']}: {r['verdict']}" for r in rows if r["verdict"] in ("regression", "differs") and not r.get("target")]


# ---------- the campaign directory ----------

class Run:
    def __init__(self, d):
        self.dir = P(d).resolve(); f = self.dir / "explore.toml"
        if not f.exists(): die(f"no explore.toml in {self.dir} (run explore init first, or point --run at the campaign directory)")
        self.c = tomllib.loads(f.read_text())
        self.rule = {"pairs": 10, "alpha": 0.05, "guard": 5, "floor": 0, "max_load": 0, **self.c.get("rules", {})}
        self.base = self.path("base_worktree"); self.strict = bool(self.c.get("strict"))

    def path(self, key): return (self.dir / (self.c.get(key) or die(f"explore.toml has no {key}"))).resolve()
    def cmd(self, name): return self.c.get("commands", {}).get(name, "")
    def wt(self, eid): return P(f"{self.dir}-{eid}")
    def agents(self, role): return self.c.get("agents", {}).get(role, [])
    def round(self): return self.dir / "rounds" / git(self.base, "rev-parse", "HEAD")[:8]

    def loop(self, key): return self.c.get("loop", {}).get(key, {"rounds": 10, "width": 3}[key])   # depth: how many rounds; width: how many investigators per round
    def kind(self, by): return max((a for a in self.agents("investigate") if by == slug(a) or by.startswith(slug(a) + "-")), key=len, default=None)   # proposal file name -> which agent
    def round_no(self): return len({d.name for d in (self.dir / "rounds").glob("*") if d.is_dir()} | {self.round().name})   # which round the current baseline is

    def round_todo(self):
        """What the round on the current baseline still lacks: the profile, and width proposals (one topic each, every configured
        agent at least once). Once the baseline moves (a landing) it is a new round."""
        d = self.round(); full = lambda f: f.exists() and f.read_text().strip(); w = self.loop("width")
        if self.round_no() > self.loop("rounds"): return [f"all {self.loop('rounds')} rounds are done (loop.rounds in explore.toml): close out and write the report. The owner raises it to go on"]
        got = [self.kind(f.stem) for f in d.glob("*.md") if f.name != "profiling.md" and full(f)] if d.is_dir() else []
        return ([] if full(d / "profiling.md") else [f"profile the current baseline: write where the time or the errors go, and this round's {w} investigation topics, to {d / 'profiling.md'}"]) + \
               ([] if len(got) >= w and None not in got else [f"{w} proposals are needed (loop.width), each on a different topic; there are {len(got) - got.count(None)}: {d}/<agent>-<topic>.md, where agent is one of {' / '.join(self.agents('investigate'))}"]) + \
               [f"investigator {a} has handed in nothing this round: {d / (slug(a) + '-<topic>.md')}" for a in self.agents("investigate") if a not in got]

    def state(self, **kw):
        f = self.dir / "state.json"; s = json.loads(f.read_text()) if f.exists() else {}
        if kw: s.update(kw); f.write_text(json.dumps(s, ensure_ascii=False, indent=1))
        return s

    def log(self, name, row):
        with open(self.dir / name, "a") as f: f.write(json.dumps({"time": now(), **row}, ensure_ascii=False) + "\n")

    def rows(self, name):
        f = self.dir / name; rows = [json.loads(x) for x in f.read_text().splitlines() if x.strip()] if f.exists() else []
        return [{**r, "status": OLD.get(r["status"], r["status"])} if "status" in r else r for r in rows]

    def last(self): return {r["id"]: r for r in self.rows("ledger.jsonl") if r["status"] not in ("amended", "snapshot")}   # the latest row of each experiment

    def identity(self):
        """The identity of a measurement: commands, rules, environment. When it changes, old calibrations and old measurements no longer count."""
        env = platform.platform() + platform.machine()
        if self.cmd("env"):
            rc, text = sh(self.cmd("env"), self.base)
            if rc: die(f"commands.env exited {rc}: {text[-300:]}")
            env += text
        tools = git(self.base, "ls-files", "-s", "--", *self.c["harness"]) if self.c.get("harness") else ""   # the contents of the measuring harness
        blob = json.dumps([self.cmd("build"), self.cmd("measure"), self.rule, env, tools], sort_keys=True, ensure_ascii=False)
        return hashlib.sha256(blob.encode()).hexdigest()[:10]

    def calibrated(self):
        aa = self.state().get("aa")
        if not aa: return None, "not calibrated yet: explore aa"
        if aa["identity"] != self.identity(): return None, "the measure command, the rules or the environment changed, so the old calibration no longer counts: explore aa"
        return aa, ""


@contextlib.contextmanager
def machine_lock(held=[]):
    """One measurement or landing per machine at a time. Reentrant."""
    if held: yield; return
    f = P.home() / ".cache/explore-loop/measure.lock"; f.parent.mkdir(parents=True, exist_ok=True)
    with open(f, "w") as lk:
        print("waiting for the measurement lock (one measurement per machine at a time)…", file=sys.stderr); fcntl.flock(lk, fcntl.LOCK_EX); held.append(1)
        try: yield
        finally: held.pop()


def fingerprint(path):
    p = P(path)
    if not p.exists(): return None
    files = [p] if p.is_file() else [f for f in p.rglob("*") if f.is_file() and ".git" not in f.parts]
    return {str(f.relative_to(p)) if f != p else ".": [f.stat().st_size, f.stat().st_mtime_ns] for f in files}


def locked_changes(R):
    f = R.dir / "locked.json"; old = json.loads(f.read_text()) if f.exists() else {}; out = []
    for path in R.c.get("locked", []):
        new, was = fingerprint((R.dir / path).resolve()), old.get(path)
        if new is None: out.append(f"{path}: does not exist")
        elif was is None: out.append(f"{path}: no snapshot (explore doctor --snapshot)")
        else: out += [f"{path}/{k}" for k in sorted(set(new) | set(was)) if new.get(k) != was.get(k)]
    return out


def block(path):
    m = re.findall(r"```json\s*\n(.*?)\n```", P(path).read_text(), re.S)
    if not m: die(f"{path}: no ```json block")
    try: return json.loads(m[-1])
    except json.JSONDecodeError as e: die(f"{path}: the json block does not parse: {e}")


def check(path):
    b = block(path); kind = b.get("kind")
    errs = [f"missing {k}" for k in NEED[kind] if k not in b] if kind in NEED else [f"kind must be one of {' / '.join(NEED)}"]
    if kind == "contract" and not errs and not b["targets"]: errs.append("targets must not be empty")
    if kind in ("review", "proposal-review") and not errs: errs += [f"finding {i + 1} lacks where or blocking" for i, f in enumerate(b["findings"]) if "where" not in f or "blocking" not in f]
    return b, errs


def contract(R, eid):
    f = R.dir / "experiments" / f"{eid}.md"
    if not f.exists(): die(f"no contract {f} (explore new)")
    b, errs = check(f)
    if errs or b.get("kind") != "contract" or b["id"] != eid: die(f"the json block of {f} is not valid: {'; '.join(errs) or 'wrong kind / id'}")
    return b, hashlib.sha256(json.dumps(b, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:10]


def proposal_review(R, eid, k, khash):
    """Gate 1: a different agent has reviewed this contract (not the code). Returns what is still missing."""
    f = R.dir / "experiments" / f"{eid}.proposal.review.md"; who = [a for a in R.agents("review") if a != R.kind(k.get("by") or "")]
    if not R.kind(k.get("by") or ""): return [f"the contract's by ({k.get('by')}) matches no investigator in agents.investigate"]
    if not f.exists(): return [f"no {f.name}: ask {' or '.join(who)} to review the contract experiments/{eid}.md; in the closing block, contract is {khash}"]
    rv, errs = check(f)
    if errs or rv["kind"] != "proposal-review" or rv["target"] != eid: return errs or [f"{f.name} needs a block with kind=proposal-review and target={eid}"]
    return ([] if rv["by"] in who else [f"reviewer {rv['by']} will not do: it must be in agents.review and must not be the proposer {k['by']} (choose from: {', '.join(who)})"]) + \
           ([] if rv["contract"] == khash else [f"the review is of contract {rv['contract']}, which is now {khash}: the contract changed, review again"]) + \
           [f"blocks the start: {x['where']}" for x in rv["findings"] if x["blocking"]]


# ---------- measuring ----------

def clean(wt):
    dirty = git(wt, "status", "--porcelain")
    return f"{wt} has uncommitted or untracked files: what gets measured would match no commit. Commit them; add build and test output to .gitignore\n{dirty[:400]}" if dirty else ""


def measure(R, *a, **kw):
    with machine_lock(): return _measure(R, *a, **kw)   # the lock has to cover everything from the cache check to writing the stamp


def _measure(R, base, cand, tag, pairs=None, redo="", expect=None):
    """Measure base and cand (both clean worktrees) in pairs. The same commits under the same measurement identity are reused. Returns (directory, data)."""
    base, cand = P(base).resolve(), P(cand).resolve(); n = pairs or R.rule["pairs"]
    for wt in (base, cand): clean(wt) and die(clean(wt))
    shas = {"base": git(base, "rev-parse", "HEAD"), "cand": git(cand, "rev-parse", "HEAD")}; ident = R.identity()
    if expect and ident != expect: die("the measurement identity (commands, rules, environment, harness) is no longer what was calibrated: explore aa")
    out = R.dir / "measure" / f"{tag}-{shas['base'][:8]}-{shas['cand'][:8]}-{ident}-n{n}"
    if redo: out = P(f"{out}-{datetime.datetime.now():%m%d%H%M%S}")
    if (out / "stamp.json").exists():
        print(f"reusing the existing measurement {out.relative_to(R.dir)} (same commits, same measurement identity)", file=sys.stderr); return out, load(out)
    if out.exists(): shutil.rmtree(out)   # left over from a measurement that did not finish
    if not R.cmd("measure"): die("explore.toml has no commands.measure")
    stamp = {"time": now(), "identity": ident, "pairs": n, "redo": redo, "loads": [], **{k: {"wt": str(w), "sha": shas[k]} for k, w in (("base", base), ("cand", cand))}}
    rng = random.Random(shas["base"] + shas["cand"]); order = []
    def quiet():
        text = sh(R.cmd("busy"), R.dir)[1].strip() if R.cmd("busy") else ""
        if text: die(f"there is other load on the machine, so this measurement is void (the passes so far do not count):\n{text}", 2)
        la = os.getloadavg()[0]; stamp["loads"].append(round(la, 1))
        if R.rule["max_load"] and la > R.rule["max_load"]: die(f"load {la:.0f} is above max_load {R.rule['max_load']}, so this measurement is void", 2)
    quiet()
    for wt, k in ({str(base): "base", str(cand): "cand"}.items() if R.cmd("build") else []):   # build the same directory only once
        if sh(R.cmd("build"), wt, out / k / "build.log")[0]: die(f"the build failed ({wt}), see {out / k / 'build.log'}")
    for i in range(1, n + 1):
        order = rng.sample(("base", "cand"), 2) if i % 2 else order[::-1]   # blocks of two pairs: a random order, then the reverse
        for k in order:
            quiet()
            rc, text = sh(R.cmd("measure"), base if k == "base" else cand, out / k / f"run-{i}.log", {"EXPLORE_RUN": str(R.dir)})
            if rc: die(f"pair {i} {k} exited {rc}, see {out / k / f'run-{i}.log'}")
        print(f"pair {i}/{n}", file=sys.stderr)
    for k, wt in (("base", base), ("cand", cand)):   # check again afterwards: is this still the commit that was measured
        if git(wt, "rev-parse", "HEAD") != shas[k] or clean(wt): die(f"{wt} changed during the measurement (commit or files), so this measurement is void. If the measure command writes files, add them to .gitignore")
    if R.identity() != ident: die("the environment changed during the measurement (commands.env prints something else now), so this measurement is void")
    data = load(out); (out / "stamp.json").write_text(json.dumps(stamp, ensure_ascii=False, indent=1))
    return out, data


# ---------- subcommands ----------

def c_init(a):
    """The campaign directory is a worktree of a separate branch (no product code) in the target repository: tracked by git,
    yet outside the main checkout and every measured worktree."""
    d = P(a.dir).resolve(); repo = P(a.repo).resolve(); name = d.name; base = P(f"{d}-base")
    if d.exists() or base.exists(): die(f"{d} or {base} already exists")
    t = (HERE / "templates" / "explore.toml").read_text()
    for k, v in (("<REPO>", str(repo)), ("<BRANCH>", f"explore/{name}-base"), ("<BASE>", str(base)), ("<ROUNDS>", a.rounds), ("<WIDTH>", a.width), ("<BUILD>", a.build), ("<MEASURE>", a.measure), ("<TEST>", a.test)):
        t = t.replace(f'"{k}"', json.dumps(v, ensure_ascii=False))   # a JSON string is also a valid TOML string
    tomllib.loads(t)   # make sure the config can be written before touching the repository
    git(repo, "worktree", "add", "-q", "--orphan", "-b", f"explore/{name}-log", str(d))
    git(repo, "worktree", "add", "-q", "-b", f"explore/{name}-base", str(base), a.start)
    for sub in ("experiments", "measure"): (d / sub).mkdir(); (d / sub / ".gitkeep").touch()
    for f in ("profile.md", "ledger.md"): shutil.copy(HERE / "templates" / f, d / f)
    (d / "explore.toml").write_text(t)
    git(d, "add", "-A"); git(d, "commit", "-q", "-m", f"explore: start campaign {name}")
    print(f"campaign directory {d} (branch explore/{name}-log)\nbaseline worktree {base} (branch explore/{name}-base, starting at {a.start})\nnext: cd {d} && explore aa")


def static(R):
    """Config problems that can be found without running anything. land checks them every time."""
    errs = [f"commands.{n} is empty" for n in ("measure", "test") if not R.cmd(n)]
    inv, rev = R.agents("investigate"), R.agents("review")
    if not inv or not rev: errs.append("[agents] in explore.toml needs investigate (investigators) and review (proposal reviewers), at least one each")
    if R.loop("width") < max(2, len(inv)) or R.loop("rounds") < 1: errs.append(f"loop.width must be at least 2 and no less than the number of investigating agents ({len(inv)}); loop.rounds must be at least 1")
    errs += [f"nobody else can review the proposals of investigator {x}: agents.review needs someone who is not {x}" for x in inv if rev and not set(rev) - {x}]
    if len({slug(x) for x in inv}) != len(inv) or "profiling" in map(slug, inv): errs.append("the names in agents.investigate must stay distinct as file names, and none may be profiling")
    if not R.base.is_dir(): return errs + [f"base_worktree {R.base} does not exist"]
    if git(R.base, "rev-parse", "--abbrev-ref", "HEAD") != R.c.get("branch"): errs.append(f"base_worktree does not have the campaign branch {R.c.get('branch')} checked out")
    for d in R.c.get("datasets", []):
        if d.get("role") not in ("train", "select", "accept", "final"): errs.append(f"the role of dataset {d.get('name')} must be train / select / accept / final")
        if not (d.get("strata") and d.get("leak")): errs.append(f"dataset {d.get('name')} needs strata (distribution, source, what was tuned on it) and leak (does it share a source with training or prior data)")
        p = (R.dir / d.get("path", "")).resolve()
        if d.get("role") == "final" and any(p.is_relative_to(x) for x in (R.path("repo"), R.base)): errs.append(f"holdout set {d['name']} is inside the repository or the baseline worktree ({p})")
    return errs


