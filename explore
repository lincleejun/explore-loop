def c_power(a):
    """Simulation: at a given noise, how often this rule blocks when nothing changed and how often it sees a real change."""
    R = Run(a.run) if (P(a.run) / "explore.toml").exists() else None; aa = R.calibrated()[0] if R else None
    rule = {"pairs": 10, "alpha": 0.05, "guard": 5, **(R.rule if R else {})}; n = a.pairs or rule["pairs"]; Z = 1.645 * math.sqrt(2)   # 90th percentile of a paired difference ≈ Z x the spread of one measurement
    if aa and a.noise is None: cvs = [aa["noise"][k] / abs(aa["median"][k]) / Z for k in aa["noise"] if aa["median"][k]]; src = "calibrated noise"
    else: cvs = [(a.noise if a.noise is not None else 3) / 100] * (a.metrics or 15); src = f"assuming a spread of {a.noise if a.noise is not None else 3}% per single measurement of each metric"
    m = (aa or {}).get("m") if (aa and a.noise is None) else len(cvs); cut = rule["alpha"] / m; rng = random.Random(1); T = 2000
    if n < need_pairs(m, rule["alpha"]): die(f"{m} metrics need at least {need_pairs(m, rule['alpha'])} pairs")
    def one(cv, shift, target):
        b = [rng.gauss(1, cv) for _ in range(n)]; c = [rng.gauss(1 + shift, cv) for _ in range(n)]; loss = max(rule["guard"] / 100, cv * Z)
        return decide(b, c, "lower", 0, loss, cut)[0]
    wrong = sum(any(one(cv, 0, False) == "regression" for cv in cvs) for _ in range(T)) / T
    print(f"{src}; {m} metrics, {n} pairs, alpha {rule['alpha']}, guard {rule['guard']}%. {T} simulations per cell.")
    print(f"probability that a guard blocks when nothing changed: {wrong:.1%}\n| real change | target judged better | guard judged regression |\n|---|---|---|")
    cv = statistics.median(cvs)
    for g in (2, 5, 10, 20):
        print(f"| {g}% | {sum(one(cv, -g / 100, True) == 'better' for _ in range(T)) / T:.0%} | {sum(one(cv, g / 100, False) == 'regression' for _ in range(T)) / T:.0%} |")
    print("This simulates independent normal noise without floor and min_gain; real drift and cache state make things worse.")
    print("If the change you want cannot be seen: raise pairs, or lower the measurement noise (clear the machine, warm up, use a bigger workload). Fix the number of pairs before looking at results.")


def selftest():
    got = parse("x\n2026 PERF open library 12.5 ms\nMETRIC higher top1 A 954 imgs\nMETRIC exact hash 9007199254740993 -\nPERF n 9 species 3\n")
    assert got["open library"]["v"] == 0.0125 and got["top1 A"]["way"] == "higher" and got["hash"]["raw"] == "9007199254740993", got
    assert tail(10, 10) == 1 / 1024 and abs(tail(17, 20) - 0.001288) < 1e-6
    assert need_pairs(15, 0.05) == 9 and need_pairs(1, 0.05) == 5
    cut = 0.05 / 15; b = [1.0] * 10
    assert decide(b, [0.9] * 10, "lower", 0, 0.05, cut)[0] == "better"
    assert decide(b, [0.9] * 9 + [5.0], "lower", 0, 0.05, cut)[0] == "inconclusive"       # 15 metrics, 10 pairs: all 10 must agree
    assert decide([1.0] * 20, [0.9] * 17 + [5.0] * 3, "lower", 0, 0.05, cut)[0] == "better"   # 20 pairs can absorb 3 outliers
    assert decide(b, [0.9] * 8 + [1.0] * 2, "lower", 0, 0.05, 0.05)[0] == "better"        # ties are left out of n
    assert decide(b, [1.2] * 10, "lower", 0, 0.05, cut)[0] == "regression"
    assert decide(b, [1.02] * 10, "lower", 0, 0.05, cut)[0] == "worse"                    # really worse, but within tolerance: not blocked
    assert decide(b, [0.99] * 10, "lower", 0.02, 0.05, cut)[0] == "inconclusive"          # better, but short of min_gain
    assert decide(b, [1.2] * 6 + [0.99] * 4, "lower", 0, 0.05, cut)[0] == "suspect"       # the median is over the line but not significant
    assert decide(b, [1.0] * 10, "lower", 0, 0.05, cut)[0] == "inconclusive"              # identical
    assert decide([954] * 10, [956] * 10, "higher", 0, 3, cut)[0] == "better" and decide([954] * 10, [940] * 10, "higher", 0, 3, cut)[0] == "regression"
    assert decide([0.0] * 10, [1.0] * 10, "lower", 0, 0.5, cut)[0] == "regression"        # a baseline of 0 can be judged too
    rng = random.Random(7); g = lambda: [rng.gauss(1, .03) for _ in range(10)]
    fp = sum(any(decide(g(), g(), "lower", 0, .05, cut)[0] == "regression" for _ in range(15)) for _ in range(400)) / 400
    assert fp <= 0.05, fp                                                                 # 15 metrics, pure noise: blocked no more often than alpha
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--run", default=os.environ.get("EXPLORE_RUN", "."))
    sub = ap.add_subparsers(dest="mode", required=True)
    def add(name, fn, *args):
        p = sub.add_parser(name); p.set_defaults(fn=fn)
        for names, kw in args: p.add_argument(*names, **kw)
    pairs = (["--pairs"], {"type": int})
    add("init", c_init, (["dir"], {}), (["--repo"], {"required": True}), (["--start"], {"default": "HEAD"}), (["--rounds"], {"type": int, "default": 10}), (["--width"], {"type": int, "default": 3}), (["--measure"], {"default": ""}), (["--test"], {"default": ""}), (["--build"], {"default": ""}))
    add("doctor", c_doctor, (["--snapshot"], {"action": "store_true"}))
    add("aa", c_aa, pairs, (["--redo"], {}))
