def c_land(a):
    R = Run(a.run); eid = a.id; wt = P(a.wt).resolve() if a.wt else R.wt(eid); k, khash = contract(R, eid); out = None
    def step(name, fails):
        print(("ok    " if not fails else "FAIL  ") + name + "".join(f"\n      {f}" for f in fails[:10]))
        if not fails: return
        if not a.dry_run: R.log("ledger.jsonl", {"id": eid, "title": k["title"], "status": "blocked", "step": name, "why": fails[:5], "measure": out and str(out.relative_to(R.dir))})
        die(f"{eid} does not land: {name}")
    def common(w): return P(git(w, "rev-parse", "--path-format=absolute", "--git-common-dir", ok=True) or "/nonexistent")
    with machine_lock():
        step("config", static(R) + ([] if wt.is_dir() and common(wt) == common(R.base) else [f"{wt} is not a worktree of this repository"]))
        step("proposal review: a different agent reviewed this contract and found nothing that blocks the start", proposal_review(R, eid, k, khash))
        frozen = R.state().get("contracts", {})
        if frozen.get(eid, khash) != khash and not a.amend: step("the contract was not changed", ["the contract's json block changed after it first passed the gate. If it really must change: --amend \"reason\" (it goes on the ledger)"])
        if frozen.get(eid) != khash:
            R.state(contracts={**frozen, eid: khash})
            if a.amend: R.log("ledger.jsonl", {"id": eid, "title": k["title"], "status": "amended", "why": a.amend})
        aa, why = R.calibrated(); step("the calibration is valid", [why] if why else [])
        sha, tip = git(wt, "rev-parse", "HEAD"), git(R.base, "rev-parse", "HEAD")
        step("the candidate is a clean commit", [clean(wt)] if clean(wt) else [])
        step("the candidate contains the current baseline", [] if git(wt, "merge-base", "HEAD", tip) == tip else [f"the baseline has moved to {tip[:8]}: merge the campaign branch into the candidate first, or the baseline's later gains will count as the candidate's regressions"])
        changed = git(wt, "diff", "--name-only", f"{tip}...HEAD").splitlines()
        step("the harness was not changed", [f"{f}: a harness change does not go through an experiment. Commit it to the campaign branch, then explore aa" for f in changed if any(fnmatch.fnmatch(f, g) for g in R.c.get("harness", []))])
        step("the change is within the contract's scope", [f for f in changed if not any(fnmatch.fnmatch(f, g) for g in k.get("allowed", ["*"]))] or ([] if changed else ["the candidate does not differ from the baseline"]))
        step("locked paths are unchanged", locked_changes(R))
        logs = R.dir / "measure" / f"{eid}-land"
        step("tests", [f"non-zero exit, see {logs / 'test.log'}"] if sh(R.cmd("test"), wt, logs / "test.log")[0] else [])
        for i, inv in enumerate(R.c.get("invariants", [])):
            step(f"invariant: {inv['name']}", [f"non-zero exit, see {logs / f'invariant-{i + 1}.log'}"] if sh(inv["cmd"], wt, logs / f"invariant-{i + 1}.log", {"EXPLORE_BASE": str(R.base)})[0] else [])
        if R.strict:
            rf = R.dir / "experiments" / f"{eid}.review.md"; rv, errs = check(rf) if rf.exists() else ({}, [f"no {rf.name}"])
            if rf.exists() and (rv.get("kind") != "review" or rv.get("target") != eid): errs.append(f"a block with kind=review and target={eid} is needed")
            if not errs:   # the review counts only if the reviewed commit has the candidate's tree (rewording a commit message needs no new review)
                same = git(wt, "rev-parse", f"{rv['sha']}^{{tree}}", ok=True) == git(wt, "rev-parse", "HEAD^{tree}")
                errs = ([] if same else [f"the review is of {rv['sha'][:8]}, the candidate is now {sha[:8]} and the code differs: review again"]) + [f"blocks the merge: {f['where']}" for f in rv["findings"] if f["blocking"]]
            if a.dry_run and errs: print("skip  code review (--dry-run): " + errs[0])
            else: step("code review: of this very code, with nothing that blocks the merge", errs)
        try: out, data = measure(R, R.base, wt, eid, redo=a.remeasure or "", expect=aa["identity"])
        except SystemExit:
            if not a.dry_run: R.log("ledger.jsonl", {"id": eid, "title": k["title"], "status": "blocked", "step": "measure", "why": ["the measurement did not finish, see the error above"]})
            raise
        step("the target metrics were measured", [f"no metric {t}" for t in k["targets"] if t not in data])
        rows = judge(data, R.rule, k["targets"], k.get("min_gain"), aa["noise"], out); by = {r["metric"]: r for r in rows}; bad = blockers(rows, k["targets"])
        if bad and a.owner_ok: print("exception  the verdict did not pass, the owner approved: " + a.owner_ok + "".join(f"\n      {m}" for m in bad))
        else: step("verdict: the targets are better and nothing else regressed", bad)
        step("nothing changed while passing the gate", ([] if git(wt, "rev-parse", "HEAD") == sha and not clean(wt) else ["the candidate changed"]) + ([] if git(R.base, "rev-parse", "HEAD") == tip else ["the baseline changed"]) + ([] if contract(R, eid)[1] == khash else ["the data block in the record changed"]) + locked_changes(R))
        row = {"id": eid, "title": k["title"], "status": "accepted", "by": k["by"], "proposal_review": block(R.dir / "experiments" / f"{eid}.proposal.review.md")["by"], "sha": sha, "base": tip, "measure": str(out.relative_to(R.dir)), "contract": khash,
               "exception": a.owner_ok if bad else None, "remeasure": a.remeasure,
               "targets": {t: {"predicted": (k.get("predict", {}).get(t) or [None, None])[1], "base": by[t].get("base"), "cand": by[t].get("cand"), "verdict": by[t]["verdict"]} for t in k["targets"]},
               "moved": {m: r["verdict"] for m, r in by.items() if not r.get("target") and r["verdict"] not in ("inconclusive", "same")}}
        if a.dry_run: print("everything passed (--dry-run, nothing merged; the real landing will reuse this measurement)"); return
        git(R.base, "merge", "--ff-only", sha)   # fast-forward: the baseline's commit is the very commit that was just measured
        R.log("ledger.jsonl", row); R.state(baseline=sha)
    print(f"{eid} landed: {R.c['branch']} -> {sha[:8]}. Write new facts or traps into ledger.md\nThe baseline moved and the bottleneck may be elsewhere now: once this round's open experiments are finished, profile again and send the investigators again before opening new experiments (explore next)")


