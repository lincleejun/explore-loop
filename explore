def c_aa(a):
    R = Run(a.run); static(R) and die("; ".join(static(R)))
    out, data = measure(R, R.base, R.base, "AA", a.pairs, a.redo or "")
    noise, med, loud = {}, {}, []
    print("| metric | median | noise (90th percentile of paired differences) | share of median |\n|---|---|---|---|")
    for k, x in sorted(data.items()):
        if x["way"] == "exact":
            if len(x["raw"]) > 1: die(f"exact metric {k} gave different values on the same code: {sorted(x['raw'])[:4]}. It is not deterministic and cannot be exact")
            continue
        d = sorted(abs(y - z) for y, z in zip(x["b"], x["c"])); noise[k] = d[min(len(d) - 1, math.ceil(0.9 * len(d)) - 1)]; med[k] = statistics.median(x["b"])
        pct = noise[k] / abs(med[k]) * 100 if med[k] else 0; loud += [k] if pct > R.rule["guard"] else []
        print(f"| {k} | {med[k]:.4g} {x['unit']} | {noise[k]:.3g} | {pct:.1f}% |")
    R.state(aa={"time": now(), "identity": json.loads((out / "stamp.json").read_text())["identity"], "m": len(data), "sha": git(R.base, "rev-parse", "HEAD"), "dir": str(out.relative_to(R.dir)), "noise": noise, "median": med}, baseline=git(R.base, "rev-parse", "HEAD"))
    if loud: print(f"note: the noise of {len(loud)} metrics is above the guard of {R.rule['guard']}% ({', '.join(loud[:5])}): their tolerance is raised to the noise, and a smaller regression will not be seen.")
    print(f"calibrated ({len(data)} metrics). To see how big a change can be detected: explore power")


