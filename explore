def c_power(a):
    """模拟：这套判定在给定噪声下，什么都没变时误拦多少，真有变化时看出多少。"""
    R = Run(a.run) if (P(a.run) / "explore.toml").exists() else None; aa = R.calibrated()[0] if R else None
    rule = {"pairs": 10, "alpha": 0.05, "guard": 5, **(R.rule if R else {})}; n = a.pairs or rule["pairs"]; Z = 1.645 * math.sqrt(2)   # 成对差的九成分位 ≈ Z × 单次离散
    if aa and a.noise is None: cvs = [aa["noise"][k] / abs(aa["median"][k]) / Z for k in aa["noise"] if aa["median"][k]]; src = "校准量到的噪声"
    else: cvs = [(a.noise if a.noise is not None else 3) / 100] * (a.metrics or 15); src = f"假设每个指标单次测量的离散是 {a.noise if a.noise is not None else 3}%"
    m = len(cvs); cut = rule["alpha"] / m; rng = random.Random(1); T = 2000
    if n < need_pairs(m, rule["alpha"]): die(f"{m} 个指标至少要 {need_pairs(m, rule['alpha'])} 对")
    def one(cv, shift, target):
        b = [rng.gauss(1, cv) for _ in range(n)]; c = [rng.gauss(1 + shift, cv) for _ in range(n)]; loss = max(rule["guard"] / 100, cv * Z)
        return decide(b, c, "lower", 0, loss, cut)[0]
    wrong = sum(any(one(cv, 0, False) == "回归" for cv in cvs) for _ in range(T)) / T
    print(f"{src}；{m} 个指标，{n} 对，alpha {rule['alpha']}，护栏 {rule['guard']}%。每格模拟 {T} 次。")
    print(f"什么都没变时，被护栏误拦的概率：{wrong:.1%}\n| 真实变化 | 目标被判变好 | 护栏被判回归 |\n|---|---|---|")
    cv = statistics.median(cvs)
    for g in (2, 5, 10, 20):
        print(f"| {g}% | {sum(one(cv, -g / 100, True) == '变好' for _ in range(T)) / T:.0%} | {sum(one(cv, g / 100, False) == '回归' for _ in range(T)) / T:.0%} |")
    print("看不出想要的变化：加 pairs，或降低测量噪声（清场、预热、加大工作负载）。")


def c_check(a):
    bad = 0
    for f in a.files:
        b, errs = check(f); bad += bool(errs)
        print(f"{'FAIL' if errs else 'ok  '}  {f}（{b.get('kind')}）" + "".join(f"\n      {e}" for e in errs))
    sys.exit(1 if bad else 0)


def selftest():
    got = parse("x\n2026 PERF open library 12.5 ms\nMETRIC higher top1 A 954 张\nMETRIC exact hash 9007199254740993 -\nPERF n 9 species 3\n")
    assert got["open library"]["v"] == 0.0125 and got["top1 A"]["way"] == "higher" and got["hash"]["raw"] == "9007199254740993", got
    assert tail(10, 10) == 1 / 1024 and abs(tail(17, 20) - 0.001288) < 1e-6
    assert need_pairs(15, 0.05) == 9 and need_pairs(1, 0.05) == 5
    cut = 0.05 / 15; b = [1.0] * 10
    assert decide(b, [0.9] * 10, "lower", 0, 0.05, cut)[0] == "变好"
    assert decide(b, [0.9] * 9 + [5.0], "lower", 0, 0.05, 0.05)[0] == "变好"          # 一个离群值打不破
    assert decide(b, [1.2] * 10, "lower", 0, 0.05, cut)[0] == "回归"
    assert decide(b, [1.02] * 10, "lower", 0, 0.05, cut)[0] == "变差"                 # 确实差了，但在容忍度内：不拦
    assert decide(b, [0.99] * 10, "lower", 0.02, 0.05, cut)[0] == "证据不足"          # 好了，但没到 min_gain
    assert decide(b, [1.2] * 6 + [0.99] * 4, "lower", 0, 0.05, cut)[0] == "可疑"      # 中位数越线但不显著
    assert decide(b, [1.0] * 10, "lower", 0, 0.05, cut)[0] == "证据不足"              # 一模一样
    assert decide([954] * 10, [956] * 10, "higher", 0, 3, cut)[0] == "变好" and decide([954] * 10, [940] * 10, "higher", 0, 3, cut)[0] == "回归"
    assert decide([0.0] * 10, [1.0] * 10, "lower", 0, 0.5, cut)[0] == "回归"           # 基线是 0 也判得出
    rng = random.Random(7); g = lambda: [rng.gauss(1, .03) for _ in range(10)]
    fp = sum(any(decide(g(), g(), "lower", 0, .05, cut)[0] == "回归" for _ in range(15)) for _ in range(400)) / 400
    assert fp <= 0.05, fp                                                             # 15 个指标、纯噪声：误拦不超过 alpha
    print("selftest ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--run", default=os.environ.get("EXPLORE_RUN", "."))
    sub = ap.add_subparsers(dest="mode", required=True)
    def add(name, fn, *args):
        p = sub.add_parser(name); p.set_defaults(fn=fn)
        for names, kw in args: p.add_argument(*names, **kw)
    pairs = (["--pairs"], {"type": int})
    add("init", c_init, (["dir"], {}), (["--repo"], {"required": True}), (["--start"], {"default": "HEAD"}), (["--measure"], {"default": ""}), (["--test"], {"default": ""}), (["--build"], {"default": ""}))
    add("doctor", c_doctor, (["--snapshot"], {"action": "store_true"}))
    add("aa", c_aa, pairs, (["--redo"], {}))
    add("ab", c_ab, (["base"], {}), (["cand"], {}), pairs)
    add("new", c_new, (["title"], {}), (["--target"], {"action": "append", "required": True}), (["--allow"], {"action": "append", "required": True}), (["--predict"], {"type": float}), (["--id"], {}))
    add("land", c_land, (["id"], {}), (["wt"], {"nargs": "?"}), (["--dry-run"], {"action": "store_true"}), (["--owner-ok"], {}), (["--amend"], {}), (["--remeasure"], {}))
    add("close", c_close, (["id"], {}), (["--as"], {"dest": "status", "required": True, "choices": ["放弃", "拒绝", "改向"]}), (["--why"], {"required": True}))
    add("holdout", c_holdout, (["name"], {}), (["--why"], {"required": True}), (["cmd"], {"nargs": "+"}))
    add("next", c_next); add("status", c_status); add("check", c_check, (["files"], {"nargs": "+"}))
    add("power", c_power, pairs, (["--noise"], {"type": float}), (["--metrics"], {"type": int}))
    add("selftest", lambda a: selftest())
    a = ap.parse_args(); a.fn(a)


if __name__ == "__main__":
    main()
