#!/usr/bin/env python3
"""explore：可测量改进实验的工具。它管三件事：量得对不对、能不能落地、记没记账。

日常（quick，默认）：
  explore init DIR --repo REPO --measure CMD --test CMD [--build CMD]   建战役目录和基线 worktree
  explore aa                        校准：同一份代码量两边，得到每个指标的噪声。换机器、换测量命令后重做
  explore new "标题" --target 指标 --allow 'src/x/*' [--predict 数]      建实验：编号、worktree、合同
  explore land E### [--dry-run]     闸门：范围 → 测试 → 不变量 →（strict：评审）→ 测量 → 判定 → 快进合并 → 记账
  explore close E### --as 放弃|拒绝|改向 --why 理由
  explore next                      现在卡在哪，下一条命令是什么
  explore status                    账本（每个实验的预测对实测）

其余：
  explore power [--noise 3] [--metrics 15] [--pairs 10]   这套判定在你的噪声下会误拦多少、能看出多大的变化
  explore ab BASE_WT CAND_WT        只比较两个 worktree，不落地
  explore doctor [--snapshot]       查配置；--snapshot 重记 locked 路径的指纹
  explore check FILE..              核对合同 / 提案 / 评审结尾的 json 块
  explore holdout NAME --why 理由 -- CMD   用一次留出集并记账
  explore selftest

战役目录：--run DIR，或环境变量 EXPLORE_RUN，或当前目录。
指标行（测量命令打印）：  PERF <名称> <数字> <s|ms>            耗时，越小越好
                          METRIC <lower|higher|exact> <名称> <值> <单位>   exact = 必须一模一样
判定：基线和候选成对测量 n 对，每个指标要同时满足两条才算变了（criterion.rs、asv 的做法）：
  方向显著：候选更好（或更差）的对数的精确二项尾概率 ≤ alpha / 指标数；幅度够大：成对差的中位数超过门槛。
  目标的门槛是合同的 min_gain（默认 0）→ 变好。其余指标的门槛是容忍度 max(guard% × 基线中位, floor, 校准量到的噪声) → 回归。
  判不出 = 证据不足，不是"没有回归"。
"""
import argparse, contextlib, datetime, fcntl, fnmatch, hashlib, json, math, os, pathlib, platform, random, re, shutil, statistics, subprocess, sys, tomllib

P = pathlib.Path
HERE = P(__file__).resolve().parent
LINE = re.compile(r"(?:PERF|BENCH) (.+?) (-?\d+(?:\.\d+)?(?:[eE]-?\d+)?) (s|ms)\s*$|METRIC (lower|higher|exact) (.+?) (\S+) (\S+)\s*$")
LABELS = ("【读到】", "【查到】", "【推导】", "【预测】", "【未验证】")
NEED = {"contract": ["id", "title", "targets", "allowed"], "proposals": ["items"], "review": ["target", "sha", "findings", "checked"]}
ITEM = {"proposals": ["metric", "baseline", "predicted", "where", "evidence", "falsify", "kill_line", "risks"],
        "review": ["where", "before", "after", "input", "blocking"]}
DONE = ("接受", "放弃", "拒绝", "改向")


def die(msg, code=1):
    print(f"explore: {msg}", file=sys.stderr); sys.exit(code)


def sh(cmd, cwd, log=None, env=None):
    p = subprocess.run(cmd, shell=True, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env={**os.environ, **(env or {})})
    if log:
        log.parent.mkdir(parents=True, exist_ok=True); log.write_text(p.stdout)
    return p.returncode, p.stdout


def git(wt, *a, ok=False):
    p = subprocess.run(["git", "-C", str(wt), *a], capture_output=True, text=True)
    if p.returncode and not ok: die(f"git {' '.join(a)}（{wt}）：{p.stderr.strip()}")
    return p.stdout.strip()


def now(): return datetime.datetime.now().isoformat(timespec="seconds")


# ---------- 指标与判定 ----------

def parse(text, where=""):
    """一遍输出 -> {名称: {v, raw, unit, way}}。同名出现两次 = 测量命令有问题，不猜。"""
    out = {}
    for m in map(LINE.search, text.splitlines()):
        if not m: continue
        name = m[1] or m[5]
        if name in out: die(f"{where}：指标 {name} 在一遍里出现了两次")
        if m[1]: out[name] = {"v": float(m[2]) / (1000 if m[3] == "ms" else 1), "raw": m[2] + m[3], "unit": "s", "way": "lower"}
        else:
            try: v = float(m[6])
            except ValueError: v = None
            if m[4] != "exact" and (v is None or not math.isfinite(v)): die(f"{where}：指标 {name} 的值 {m[6]} 不是有限的数字")
            out[name] = {"v": v, "raw": m[6], "unit": m[7], "way": m[4]}
    return out


def tail(k, n):
    """n 对里至少 k 对的精确概率（每对各半）。"""
    return sum(math.comb(n, j) for j in range(k, n + 1)) / 2 ** n


def decide(b, c, way, gain, loss, cut):
    """b[i]、c[i] 是同一对里的基线和候选。两个条件都满足才算数：方向显著（符号检验），而且中位差超过门槛。
    返回 (判定, 候选更好的对数, 候选更差的对数)。"""
    s = 1 if way == "higher" else -1
    d = [s * (y - x) for x, y in zip(b, c)]; n = len(d); med = statistics.median(d)
    up, down = sum(x > 0 for x in d), sum(x < 0 for x in d)
    if tail(up, n) <= cut: return ("变好" if med > gain else "证据不足"), up, down
    if tail(down, n) <= cut: return ("回归" if med < -loss else "变差"), up, down     # 变差 = 确实差了，但在容忍度内
    return ("可疑" if med < -loss else "证据不足"), up, down                          # 可疑 = 中位差越线，但方向不显著


def need_pairs(m, alpha): return math.ceil(math.log2(m / alpha))   # 少于这个数，全部同向也到不了显著


def load(out):
    """测量目录 -> {名称: {unit, way, b: [..], c: [..], raw: set}}。每一遍的指标集合、单位、方向必须一致。"""
    out = P(out); data = {}; n = len(list((out / "base").glob("run-*.log")))
    if not n or n != len(list((out / "cand").glob("run-*.log"))): die(f"{out}：两边的遍数不一样或为零")
    for i in range(1, n + 1):
        for side in ("base", "cand"):
            f = out / side / f"run-{i}.log"; got = parse(f.read_text(), str(f))
            if i == 1 and side == "base": data = {k: {"unit": v["unit"], "way": v["way"], "b": [], "c": [], "raw": set()} for k, v in got.items()}
            if {k: (v["unit"], v["way"]) for k, v in got.items()} != {k: (v["unit"], v["way"]) for k, v in data.items()}:
                die(f"{f}：指标的集合、单位或方向和第一遍不一样（少了指标 = 有东西被静默跳过）：{sorted(set(got) ^ set(data)) or '单位 / 方向变了'}")
            for k, v in got.items(): data[k]["b" if side == "base" else "c"].append(v["v"]); data[k]["raw"].add(v["raw"])
    if not data: die(f"{out}：没有任何指标行")
    return data


def judge(data, rule, targets=(), gains=None, noise=None, out=None):
    m = len(data); n = len(next(iter(data.values()))["b"]); cut = rule["alpha"] / m; rows = []
    if n < need_pairs(m, rule["alpha"]): die(f"{m} 个指标、alpha {rule['alpha']} 至少要 {need_pairs(m, rule['alpha'])} 对才可能判出变化，现在只有 {n} 对")
    for k, x in sorted(data.items()):
        if x["way"] == "exact":
            rows.append({"metric": k, "verdict": "相同" if len(x["raw"]) == 1 else "不同", "values": sorted(x["raw"])[:4]}); continue
        mb, mc = statistics.median(x["b"]), statistics.median(x["c"])
        loss = max(rule["guard"] / 100 * abs(mb), rule["floor"], (noise or {}).get(k, 0))
        v, up, down = decide(x["b"], x["c"], x["way"], (gains or {}).get(k, 0) if k in targets else 0, loss, cut)
        rows.append({"metric": k, "unit": x["unit"], "verdict": v, "base": mb, "cand": mc, "change": round((mc - mb) / abs(mb) * 100, 2) if mb else None,
                     "up": up, "down": down, "n": n, "loss": loss, "target": k in targets})
    def line(r):
        if "base" not in r: return f"| {r['metric']} | {' / '.join(r['values'])} | | | | {r['verdict']} |"
        ch = f"{r['change']:+.1f}%" if r["change"] is not None else "—"
        return f"| {'**' + r['metric'] + '**' if r['target'] else r['metric']} | {r['base']:.4g} {r['unit']} | {r['cand']:.4g} {r['unit']} | {ch} | 好 {r['up']} / 差 {r['down']} / 共 {r['n']} | {r['verdict']} |"
    head = ["| 指标（**目标**） | 基线中位 | 候选中位 | 变化 | 成对比较 | 判定 |", "|---|---|---|---|---|---|"]
    show = [r for r in rows if r.get("target") or r["verdict"] not in ("证据不足", "相同")]   # 只显示目标和动了的
    print("\n".join(head + [line(r) for r in show])); print(f"其余 {len(rows) - len(show)} 个指标没有可判定的变化（显著线：单侧 p ≤ {cut:.4f}）")
    if out:
        (P(out) / "verdict.json").write_text(json.dumps(rows, ensure_ascii=False, indent=1))
        (P(out) / "verdict.md").write_text("\n".join(head + [line(r) for r in rows]) + "\n")
    return rows


def blockers(rows, targets):
    by = {r["metric"]: r for r in rows}
    return [f"目标 {t}：{by.get(t, {}).get('verdict', '没量到')}" for t in targets if by.get(t, {}).get("verdict") != "变好"] + \
           [f"{r['metric']}：{r['verdict']}" for r in rows if r["verdict"] in ("回归", "不同") and not r.get("target")]


# ---------- 战役目录 ----------

class Run:
    def __init__(self, d):
        self.dir = P(d).resolve(); f = self.dir / "explore.toml"
        if not f.exists(): die(f"{self.dir} 里没有 explore.toml（先 explore init，或用 --run 指定战役目录）")
        self.c = tomllib.loads(f.read_text())
        self.rule = {"pairs": 10, "alpha": 0.05, "guard": 5, "floor": 0, "max_load": 0, **self.c.get("rules", {})}
        self.base = self.path("base_worktree"); self.strict = bool(self.c.get("strict"))

    def path(self, key): return (self.dir / (self.c.get(key) or die(f"explore.toml 缺 {key}"))).resolve()
    def cmd(self, name): return self.c.get("commands", {}).get(name, "")
    def wt(self, eid): return P(f"{self.dir}-{eid}")

    def state(self, **kw):
        f = self.dir / "state.json"; s = json.loads(f.read_text()) if f.exists() else {}
        if kw: s.update(kw); f.write_text(json.dumps(s, ensure_ascii=False, indent=1))
        return s

    def log(self, name, row):
        with open(self.dir / name, "a") as f: f.write(json.dumps({"time": now(), **row}, ensure_ascii=False) + "\n")

    def rows(self, name):
        f = self.dir / name
        return [json.loads(x) for x in f.read_text().splitlines() if x.strip()] if f.exists() else []

    def last(self): return {r["id"]: r for r in self.rows("ledger.jsonl") if r["status"] not in ("改合同", "快照")}   # 每个实验最新的一行

    def identity(self):
        """测量的身份：命令、规则、环境。变了，旧的校准和旧的测量都不算数。"""
        env = platform.platform() + platform.machine()
        if self.cmd("env"):
            rc, text = sh(self.cmd("env"), self.base)
            if rc: die(f"commands.env 退出码 {rc}：{text[-300:]}")
            env += text
        blob = json.dumps([self.cmd("build"), self.cmd("measure"), self.rule, env], sort_keys=True, ensure_ascii=False)
        return hashlib.sha256(blob.encode()).hexdigest()[:10]

    def calibrated(self):
        aa = self.state().get("aa")
        if not aa: return None, "还没校准：explore aa"
        if aa["identity"] != self.identity(): return None, "测量命令、规则或环境变了，旧的校准不算数：explore aa"
        return aa, ""


@contextlib.contextmanager
def machine_lock(held=[]):
    """一台机器同时只有一个测量或落地。可重入。"""
    if held: yield; return
    f = P.home() / ".cache/explore-loop/measure.lock"; f.parent.mkdir(parents=True, exist_ok=True)
    with open(f, "w") as lk:
        print("等测量锁（一台机器同时只量一个）…", file=sys.stderr); fcntl.flock(lk, fcntl.LOCK_EX); held.append(1)
        try: yield
        finally: held.pop()


def fingerprint(path):
    p = P(path)
    if not p.exists(): return None
    files = [p] if p.is_file() else [f for f in p.rglob("*") if f.is_file() and ".git" not in f.parts]
    return {str(f.relative_to(p)) if f != p else ".": [f.stat().st_size, f.stat().st_mtime_ns] for f in files}


def locked_changes(R):
    f = R.dir / "locked.json"; old = json.loads(f.read_text()) if f.exists() else {}; out = []
    for path in R.c.get("locked", []):
        new, was = fingerprint((R.dir / path).resolve()), old.get(path)
        if new is None: out.append(f"{path}：不存在")
        elif was is None: out.append(f"{path}：没有快照（explore doctor --snapshot）")
        else: out += [f"{path}/{k}" for k in sorted(set(new) | set(was)) if new.get(k) != was.get(k)]
    return out


def block(path):
    m = re.findall(r"```json\s*\n(.*?)\n```", P(path).read_text(), re.S)
    if not m: die(f"{path}：没有 ```json 块")
    try: return json.loads(m[-1])
    except json.JSONDecodeError as e: die(f"{path}：json 块解析失败：{e}")


def check(path):
    b = block(path); kind = b.get("kind")
    errs = [f"缺 {k}" for k in NEED[kind] if k not in b] if kind in NEED else [f"kind 必须是 {' / '.join(NEED)}"]
    items = b.get("items", b.get("findings", [])) if kind in ITEM else []
    for i, it in enumerate(items): errs += [f"第 {i + 1} 项缺 {k}" for k in ITEM[kind] if k not in it]
    if kind == "contract" and not errs: errs += [f"{k} 不能空" for k in ("targets", "allowed") if not b[k]]
    if kind == "proposals" and not items and not b.get("exhausted"): errs.append("没有提案时要写 exhausted（这条路到头了的证据）")
    if kind == "review" and not b.get("checked"): errs.append("checked 不能空：没有发现也要列出查过什么")
    if kind in ITEM and not any(l in P(path).read_text() for l in LABELS): errs.append(f"正文没有证据等级标签（{' '.join(LABELS)}）")
    return b, errs


def contract(R, eid):
    f = R.dir / "experiments" / f"{eid}.md"
    if not f.exists(): die(f"没有合同 {f}（explore new）")
    b, errs = check(f)
    if errs or b.get("kind") != "contract" or b["id"] != eid: die(f"{f} 的 json 块不合格：{'；'.join(errs) or 'kind / id 不对'}")
    return b, hashlib.sha256(json.dumps(b, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:10]


# ---------- 测量 ----------

def clean(wt):
    dirty = git(wt, "status", "--porcelain")
    return f"{wt} 有未提交或未跟踪的文件：量到的东西对不上任何提交。提交它们；构建和测试的产物加进 .gitignore\n{dirty[:400]}" if dirty else ""


def measure(R, base, cand, tag, pairs=None, redo=""):
    """成对测量 base 和 cand（都是干净的 worktree）。同样的提交、同样的测量身份量过就直接复用。返回 (目录, data)。"""
    base, cand = P(base).resolve(), P(cand).resolve(); n = pairs or R.rule["pairs"]
    for wt in (base, cand): clean(wt) and die(clean(wt))
    shas = {"base": git(base, "rev-parse", "HEAD"), "cand": git(cand, "rev-parse", "HEAD")}; ident = R.identity()
    out = R.dir / "measure" / f"{tag}-{shas['base'][:8]}-{shas['cand'][:8]}-{ident}-n{n}"
    if redo: out = P(f"{out}-{datetime.datetime.now():%m%d%H%M%S}")
    if (out / "stamp.json").exists():
        print(f"复用已有的测量 {out.relative_to(R.dir)}（提交和测量身份都没变）", file=sys.stderr); return out, load(out)
    if out.exists(): shutil.rmtree(out)   # 上次没量完的残留
    if not R.cmd("measure"): die("explore.toml 缺 commands.measure")
    stamp = {"time": now(), "identity": ident, "pairs": n, "redo": redo, "loads": [], **{k: {"wt": str(w), "sha": shas[k]} for k, w in (("base", base), ("cand", cand))}}
    rng = random.Random(shas["base"] + shas["cand"])
    with machine_lock():
        def quiet():
            text = sh(R.cmd("busy"), R.dir)[1].strip() if R.cmd("busy") else ""
            if text: die(f"机器上有别的负载，这次测量作废（已有的几遍不算数）：\n{text}", 2)
            la = os.getloadavg()[0]; stamp["loads"].append(round(la, 1))
            if R.rule["max_load"] and la > R.rule["max_load"]: die(f"负载 {la:.0f} 超过 max_load {R.rule['max_load']}，这次测量作废", 2)
        quiet()
        for wt, k in ({str(base): "base", str(cand): "cand"}.items() if R.cmd("build") else []):   # 同一个目录只构建一次
            if sh(R.cmd("build"), wt, out / k / "build.log")[0]: die(f"构建失败（{wt}），见 {out / k / 'build.log'}")
        for i in range(1, n + 1):
            for k in rng.sample(("base", "cand"), 2):   # 每对随机谁先
                quiet()
                rc, text = sh(R.cmd("measure"), base if k == "base" else cand, out / k / f"run-{i}.log", {"EXPLORE_RUN": str(R.dir)})
                if rc: die(f"第 {i} 对 {k} 退出码 {rc}，见 {out / k / f'run-{i}.log'}")
            print(f"第 {i}/{n} 对", file=sys.stderr)
        for k, wt in (("base", base), ("cand", cand)):   # 量完再核一次：量的还是那个提交吗
            if git(wt, "rev-parse", "HEAD") != shas[k] or clean(wt): die(f"测量期间 {wt} 变了（提交或文件），这次测量作废。测量命令会写文件的话，把产物加进 .gitignore")
    data = load(out); (out / "stamp.json").write_text(json.dumps(stamp, ensure_ascii=False, indent=1))
    return out, data


# ---------- 子命令 ----------

def c_init(a):
    """战役目录是目标仓库里一条独立分支（没有产品代码）的 worktree：被 git 跟踪，又不在主检出和任何被测的 worktree 里。"""
    d = P(a.dir).resolve(); repo = P(a.repo).resolve(); name = d.name; base = P(f"{d}-base")
    if d.exists() or base.exists(): die(f"{d} 或 {base} 已经存在")
    git(repo, "worktree", "add", "-q", "--orphan", "-b", f"explore/{name}-log", str(d))
    git(repo, "worktree", "add", "-q", "-b", f"explore/{name}-base", str(base), a.start)
    for sub in ("experiments", "measure"): (d / sub).mkdir(); (d / sub / ".gitkeep").touch()
    for f in ("explore.toml", "profile.md", "ledger.md"): shutil.copy(HERE / "templates" / f, d / f)
    t = (d / "explore.toml").read_text()
    for k, v in (("<REPO>", str(repo)), ("<BRANCH>", f"explore/{name}-base"), ("<BASE>", str(base)), ("<BUILD>", a.build), ("<MEASURE>", a.measure), ("<TEST>", a.test)):
        t = t.replace(k, v.replace("\\", "\\\\").replace('"', '\\"'))
    (d / "explore.toml").write_text(t); tomllib.loads(t)
    git(d, "add", "-A"); git(d, "commit", "-q", "-m", f"explore: start campaign {name}")
    print(f"战役目录 {d}（分支 explore/{name}-log）\n基线 worktree {base}（分支 explore/{name}-base，起点 {a.start}）\n下一步：cd {d} && explore aa")


def static(R):
    """不用跑任何东西就能查的配置问题。land 每次都查。"""
    errs = [f"commands.{n} 是空的" for n in ("measure", "test") if not R.cmd(n)]
    if not R.base.is_dir(): return errs + [f"base_worktree {R.base} 不存在"]
    if git(R.base, "rev-parse", "--abbrev-ref", "HEAD") != R.c.get("branch"): errs.append(f"base_worktree 检出的不是战役分支 {R.c.get('branch')}")
    for d in R.c.get("datasets", []):
        if d.get("role") not in ("train", "select", "accept", "final"): errs.append(f"数据集 {d.get('name')} 的 role 要是 train / select / accept / final")
        if not (d.get("strata") and d.get("leak")): errs.append(f"数据集 {d.get('name')} 要写 strata（分布、来源、调过什么）和 leak（与训练或先验数据同源吗）")
        p = (R.dir / d.get("path", "")).resolve()
        if d.get("role") == "final" and any(p.is_relative_to(x) for x in (R.path("repo"), R.base)): errs.append(f"留出集 {d['name']} 在仓库或基线 worktree 里（{p}）")
    return errs


def c_doctor(a):
    R = Run(a.run); errs = static(R)
    if a.snapshot:
        (R.dir / "locked.json").write_text(json.dumps({p: fingerprint((R.dir / p).resolve()) for p in R.c.get("locked", [])}))
        R.log("ledger.jsonl", {"id": "-", "title": "重记 locked 指纹", "status": "快照"})
    errs += locked_changes(R); errs += [R.calibrated()[1]] if R.calibrated()[1] else []
    for e in errs: print("FAIL  " + e)
    for n, on in (("build", R.cmd("build")), ("env（环境指纹）", R.cmd("env")), ("busy（机器忙不忙）", R.cmd("busy")), ("invariants", R.c.get("invariants")),
                  ("locked", R.c.get("locked")), ("strict（落地要评审）", R.strict)):
        print(("ok    " if on else "没设  ") + n)
    print("配置没问题" if not errs else f"{len(errs)} 个问题"); sys.exit(1 if errs else 0)


def c_aa(a):
    R = Run(a.run); static(R) and die("；".join(static(R)))
    out, data = measure(R, R.base, R.base, "AA", a.pairs, a.redo or "")
    noise, med, loud = {}, {}, []
    print("| 指标 | 中位 | 噪声（成对差的九成分位） | 占中位 |\n|---|---|---|---|")
    for k, x in sorted(data.items()):
        if x["way"] == "exact":
            if len(x["raw"]) > 1: die(f"exact 指标 {k} 在同一份代码上量出了不同的值：{sorted(x['raw'])[:4]}。它不是确定性的，不能当 exact")
            continue
        d = sorted(abs(y - z) for y, z in zip(x["b"], x["c"])); noise[k] = d[min(len(d) - 1, math.ceil(0.9 * len(d)) - 1)]; med[k] = statistics.median(x["b"])
        pct = noise[k] / abs(med[k]) * 100 if med[k] else 0; loud += [k] if pct > R.rule["guard"] else []
        print(f"| {k} | {med[k]:.4g} {x['unit']} | {noise[k]:.3g} | {pct:.1f}% |")
    R.state(aa={"time": now(), "identity": R.identity(), "sha": git(R.base, "rev-parse", "HEAD"), "dir": str(out.relative_to(R.dir)), "noise": noise, "median": med}, baseline=git(R.base, "rev-parse", "HEAD"))
    if loud: print(f"提示：{len(loud)} 个指标的噪声超过护栏的 {R.rule['guard']}%（{'，'.join(loud[:5])}）：它们的容忍度会自动抬到噪声那么大，比这小的回归看不出来。")
    print(f"校准完成（{len(data)} 个指标）。想知道能看出多大的变化：explore power")


