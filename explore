def c_land(a):
    R = Run(a.run); eid = a.id; wt = P(a.wt).resolve() if a.wt else R.wt(eid); k, khash = contract(R, eid); out = None
    def step(name, fails):
        print(("ok    " if not fails else "FAIL  ") + name + "".join(f"\n      {f}" for f in fails[:10]))
        if not fails: return
        if not a.dry_run: R.log("ledger.jsonl", {"id": eid, "title": k["title"], "status": "拦下", "step": name, "why": fails[:5], "measure": out and str(out.relative_to(R.dir))})
        die(f"{eid} 不落地：{name}")
    def common(w): return P(git(w, "rev-parse", "--path-format=absolute", "--git-common-dir", ok=True) or "/nonexistent")
    with machine_lock():
        step("配置", static(R) + ([] if wt.is_dir() and common(wt) == common(R.base) else [f"{wt} 不是这个仓库的 worktree"]))
        frozen = R.state().get("contracts", {})
        if frozen.get(eid, khash) != khash and not a.amend: step("合同没被改过", ["合同的 json 块在第一次过闸门之后改过。确实要改：--amend \"理由\"（会记账）"])
        if frozen.get(eid) != khash:
            R.state(contracts={**frozen, eid: khash})
            if a.amend: R.log("ledger.jsonl", {"id": eid, "title": k["title"], "status": "改合同", "why": a.amend})
        aa, why = R.calibrated(); step("校准有效", [why] if why else [])
        sha, tip = git(wt, "rev-parse", "HEAD"), git(R.base, "rev-parse", "HEAD")
        step("候选是干净的提交", [clean(wt)] if clean(wt) else [])
        step("候选包含当前基线", [] if git(wt, "merge-base", "HEAD", tip) == tip else [f"基线已经走到 {tip[:8]}：先把战役分支合进候选，否则基线后来的改进会算成候选的回归"])
        changed = git(wt, "diff", "--name-only", f"{tip}...HEAD").splitlines()
        step("改动在合同范围内", [f for f in changed if not any(fnmatch.fnmatch(f, g) for g in k["allowed"])] or ([] if changed else ["候选和基线没有差别"]))
        step("locked 路径没变", locked_changes(R))
        logs = R.dir / "measure" / f"{eid}-land"
        step("测试", [f"退出码非 0，见 {logs / 'test.log'}"] if sh(R.cmd("test"), wt, logs / "test.log")[0] else [])
        for i, inv in enumerate(R.c.get("invariants", [])):
            step(f"不变量：{inv['name']}", [f"退出码非 0，见 {logs / f'invariant-{i + 1}.log'}"] if sh(inv["cmd"], wt, logs / f"invariant-{i + 1}.log", {"EXPLORE_BASE": str(R.base)})[0] else [])
        if R.strict:
            rf = R.dir / "experiments" / f"{eid}.review.md"; rv, errs = check(rf) if rf.exists() else ({}, [f"没有 {rf.name}"])
            if rf.exists() and (rv.get("kind") != "review" or rv.get("target") != eid): errs.append(f"要的是 kind=review、target={eid} 的块")
            if not errs:   # 评审的提交和候选的代码树相同才算数（只改提交说明不用重审）
                same = git(wt, "rev-parse", f"{rv['sha']}^{{tree}}", ok=True) == git(wt, "rev-parse", "HEAD^{tree}")
                errs = ([] if same else [f"评审的是 {rv['sha'][:8]}，候选现在是 {sha[:8]}，代码不一样：重新评审"]) + [f"挡合并：{f['where']}（{f['input']}）" for f in rv["findings"] if f["blocking"]]
            if a.dry_run and errs: print("跳过  评审（--dry-run）：" + errs[0])
            else: step("评审：针对这份代码，没有挡合并的发现", errs)
        out, data = measure(R, R.base, wt, eid, redo=a.remeasure or "")
        step("目标指标量到了", [f"没有指标 {t}" for t in k["targets"] if t not in data])
        rows = judge(data, R.rule, k["targets"], k.get("min_gain"), aa["noise"], out); by = {r["metric"]: r for r in rows}; bad = blockers(rows, k["targets"])
        if bad and a.owner_ok: print("破例  判定没过，所有者批准：" + a.owner_ok + "".join(f"\n      {m}" for m in bad))
        else: step("判定：目标变好，其余没有回归", bad)
        step("过闸门期间什么都没变", ([] if git(wt, "rev-parse", "HEAD") == sha and not clean(wt) else ["候选变了"]) + ([] if git(R.base, "rev-parse", "HEAD") == tip else ["基线变了"]) + locked_changes(R))
        row = {"id": eid, "title": k["title"], "status": "接受", "sha": sha, "base": tip, "measure": str(out.relative_to(R.dir)), "contract": khash,
               "exception": a.owner_ok if bad else None, "remeasure": a.remeasure,
               "targets": {t: {"predicted": (k.get("predict", {}).get(t) or [None, None])[1], "base": by[t].get("base"), "cand": by[t].get("cand"), "verdict": by[t]["verdict"]} for t in k["targets"]},
               "moved": {m: r["verdict"] for m, r in by.items() if not r.get("target") and r["verdict"] not in ("证据不足", "相同")}}
        if a.dry_run: print("全部通过（--dry-run，没有合并；正式落地会复用这次测量）"); return
        git(R.base, "merge", "--ff-only", sha)   # 快进：基线的提交就是刚量过的那个提交
        R.log("ledger.jsonl", row); R.state(baseline=sha)
    print(f"{eid} 落地：{R.c['branch']} → {sha[:8]}。有新的事实或陷阱就写进 ledger.md")


